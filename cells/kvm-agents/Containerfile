# Ubuntu 26.04 LTS, pinned to the release rather than to an image: the tag
# follows Ubuntu's refreshed images within 26.04 and never moves to the next
# LTS on its own, so changing release stays a deliberate edit here.
FROM docker.io/library/ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

# Without this the image has no locale at all, and every terminal program falls
# back to ASCII: tmux rewrites each wide character as an underscore, so the
# agents' status marks and anything else non-ASCII arrive mangled. C.UTF-8 is
# built into glibc, so it needs no locale package.
ENV LANG=C.UTF-8

# Every update Ubuntu has published, before anything else is installed. The
# image on Docker Hub is refreshed only every few weeks and is behind from the
# day it is cut, and the container is started over from this image at every
# boot, so a patch applied inside a running cell would be gone by the next one:
# the build is the one place a patch lasts. `solitary up --rebuild` builds
# without a cache, so each rebuild takes whatever has been published since.
# Phased updates are taken too — Ubuntu holds some back while it rolls them out
# a fraction of machines at a time, and a rebuild should not depend on which
# fraction it landed in.
#
# Then the base tools. ripgrep and fd are what Claude Code reaches for; the rest
# is what any of this needs to fetch and verify anything else.
RUN apt-get update \
 && apt-get upgrade -y -o APT::Get::Always-Include-Phased-Updates=true \
 && apt-get install -y --no-install-recommends \
      ca-certificates curl git gnupg jq less ripgrep fd-find unzip tzdata \
      build-essential python3 ncurses-term \
 && rm -rf /var/lib/apt/lists/* \
 # Debian and Ubuntu ship fd as fdfind; everything that looks for it, including
 # LazyVim, expects the real name.
 && ln -s /usr/bin/fdfind /usr/local/bin/fd

# GitHub CLI, from its own apt repository rather than a distro snapshot, so apt
# verifies every package against GitHub's signing key — once the keyring is
# shown to hold the key below, as cli.github.com's own install page lists it. A
# gh release changes nothing here, and a new key is a change worth noticing, so
# a keyring without it fails the build rather than being trusted because it
# arrived over HTTPS.
ARG GH_KEY_FINGERPRINT=7F38BBB59D064DBCB3D84D725612B36462313325

RUN keyring=/etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && mkdir -p -m 755 /etc/apt/keyrings \
 && curl -fsSL -o "$keyring" https://cli.github.com/packages/githubcli-archive-keyring.gpg \
 && chmod go+r "$keyring" \
 && if ! gpg --show-keys --with-colons "$keyring" | grep -q "^fpr:*${GH_KEY_FINGERPRINT}:"; then \
      echo "GitHub CLI's keyring no longer holds ${GH_KEY_FINGERPRINT}; check cli.github.com and update GH_KEY_FINGERPRINT" >&2; \
      exit 1; \
    fi \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=$keyring] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

# gh is not pinned, so it is as new as the last rebuild; telling every shell
# about a newer one only names a version the cell gets by rebuilding.
ENV GH_NO_UPDATE_NOTIFIER=1

# Let git push over https authenticate the way gh does, using GH_TOKEN from the
# environment. This belongs to the image rather than to something set up by hand
# inside the cell, so it survives the cell being rebuilt from scratch. The
# identity to commit under is not here: git reads that from GIT_AUTHOR_* and
# GIT_COMMITTER_*, which cell.yaml declares.
RUN git config --system credential."https://github.com".helper '!/usr/bin/gh auth git-credential' \
 && git config --system credential."https://gist.github.com".helper '!/usr/bin/gh auth git-credential'

# nvm, installed system-wide so both this build and later shells see it.
ENV NVM_DIR=/usr/local/nvm
ENV NVM_VERSION=v0.40.8
ENV NODE_VERSION=24

RUN mkdir -p "$NVM_DIR" \
 && curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh" | bash \
 && . "$NVM_DIR/nvm.sh" \
 && nvm install "$NODE_VERSION" \
 && nvm alias default "$NODE_VERSION" \
 # A stable path to whichever v24.x nvm resolved, so PATH does not have to
 # name the patch version.
 && ln -s "$NVM_DIR/versions/node/$(nvm version default)" /usr/local/node

ENV PATH=/usr/local/node/bin:$PATH
# npm's own notice, for the same reason as gh's: node is pinned here, and npm
# comes with it.
ENV NPM_CONFIG_UPDATE_NOTIFIER=false

# Make nvm itself usable in interactive shells, not just the pinned default.
# solitary opens a non-login shell, which reads /etc/bash.bashrc but not
# /etc/profile.d, so wire up both.
RUN printf '%s\n' \
      'export NVM_DIR=/usr/local/nvm' \
      '[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"' \
      > /etc/profile.d/nvm.sh \
 && echo '. /etc/profile.d/nvm.sh' >> /etc/bash.bashrc

# The prompt, wired up the same way and appended after Ubuntu's own PS1 so that
# it wins.
#
# --chmod, here and on every COPY below: solitary stages a build context in a
# temporary directory on the host and writes it there 0600, so whatever a file's
# mode is in git, it arrives in the image readable by root and no one else. That
# is invisible in a cell that runs as root and breaks everything in one that does
# not, quietly — an unreadable /etc/profile.d file is skipped without a word, and
# this one is the prompt.
COPY --chmod=0644 prompt.sh /etc/profile.d/solitary-prompt.sh
RUN echo '. /etc/profile.d/solitary-prompt.sh' >> /etc/bash.bashrc

# The agents: Claude Code, Codex and opencode, all at their latest, and none of
# them updates itself. The container is started over from this image every time
# the machine boots, so an update downloaded into it lasts until the next boot
# and is downloaded again after it. `solitary up --rebuild`, or b in the
# dashboard, builds this file again without a cache, and that is what brings in
# newer ones.
#
# opencode is as it comes but for one plugin, the window marks below: no LSP, no
# MCP servers, nothing else. It reads the cell note from ~/.claude/CLAUDE.md,
# which it falls back to when it has no AGENTS.md. Its npm package carries the
# binary for each platform as a dependency, so npm is all it is fetched from.
#
# OPENCODE_CONFIG_DIR is read alongside ~/.config/opencode rather than instead
# of it, which is what lets the image ship that plugin into a home it cannot
# write.
ENV DISABLE_AUTOUPDATER=1 OPENCODE_DISABLE_AUTOUPDATE=1 \
    OPENCODE_CONFIG_DIR=/etc/opencode

RUN npm install -g @anthropic-ai/claude-code @openai/codex opencode-ai \
 && npm cache clean --force

# tmux, built from source for its version alone: Ubuntu's own would read
# tmux.conf too, extended-keys-format included, but it is older than the host's.
# This is the one pin here that is ahead of the host rather than matched to it:
# tmux's latest release, which the host's packages have not caught up with.
# tmux.conf and the theme behave the same on it as on the host's 3.7c.
ENV TMUX_VERSION=3.8

RUN apt-get update \
 && apt-get install -y --no-install-recommends libevent-dev libncurses-dev bison pkg-config \
 && curl -fsSL -o /tmp/tmux.tar.gz \
      "https://github.com/tmux/tmux/releases/download/${TMUX_VERSION}/tmux-${TMUX_VERSION}.tar.gz" \
 && tar -C /tmp -xzf /tmp/tmux.tar.gz \
 && cd /tmp/tmux-${TMUX_VERSION} \
 && ./configure \
 && make -j"$(nproc)" \
 && make install \
 && cd / \
 && rm -rf /tmp/tmux.tar.gz /tmp/tmux-${TMUX_VERSION} \
 && rm -rf /var/lib/apt/lists/*

# tmux is configured system-wide. It reads /etc/tmux.conf before anything in a
# home directory, which is what makes this work here: the cell's home is a
# mount from the machine and hides whatever the image puts under it.
#
# The theme is the one plugin, and tmux.conf loads it itself: a plugin manager
# exists to fetch plugins on first run, and this one is fetched here, so a fresh
# cell has a working status bar without pressing anything. What tmux-sensible
# used to add is written into tmux.conf.
#
# Pinned: the theme is the visible half of this config, and it should not
# change because an image was rebuilt on a different day. A release ahead of
# the host's v2.3.0, like tmux: 2.3.1 and 2.3.2 fix the command prompt and
# message styling that tmux 3.7 broke.
RUN git clone --depth 1 --branch v2.3.2 https://github.com/catppuccin/tmux /etc/tmux/catppuccin \
 && test -f /etc/tmux/catppuccin/catppuccin.tmux

# tmux is the quietest of them: given a config file it cannot read, it starts
# anyway with none of this applied and reports nothing.
COPY --chmod=0644 tmux.conf /etc/tmux.conf
COPY --chmod=0755 system-stats.sh /etc/tmux/system-stats.sh
# Marks the tmux window an agent runs in, and tmux.conf shows the mark. All
# three agents call it: Claude Code from the hooks in its managed settings,
# below; Codex from the hooks in its system config; opencode from a plugin.
COPY --chmod=0755 agent-status /usr/local/bin/agent-status
COPY --chmod=0644 codex-config.toml /etc/codex/config.toml
COPY --chmod=0644 opencode/plugins/agent-status.js /etc/opencode/plugins/agent-status.js

# Neovim, from the project's own tarball: Ubuntu's package is far too old for
# LazyVim. The version matches the host's.
ENV NVIM_VERSION=v0.12.6

RUN curl -fsSL -o /tmp/nvim.tar.gz \
      "https://github.com/neovim/neovim/releases/download/${NVIM_VERSION}/nvim-linux-x86_64.tar.gz" \
 && tar -C /opt -xzf /tmp/nvim.tar.gz \
 && rm -f /tmp/nvim.tar.gz

# nvim's config and plugins belong to the image, for the same reason as tmux's:
# nothing under the home directory survives. A wrapper points the two XDG
# directories that hold them at the image, and leaves state and cache alone so
# that shada, undo history and the like still land in the home and outlive a new
# container.
RUN printf '%s\n' \
      '#!/bin/sh' \
      'export XDG_CONFIG_HOME=/opt/nvim/config' \
      'export XDG_DATA_HOME=/opt/nvim/data' \
      'exec /opt/nvim-linux-x86_64/bin/nvim "$@"' \
      > /usr/local/bin/nvim \
 && chmod 0755 /usr/local/bin/nvim

ENV EDITOR=nvim VISUAL=nvim

# The tree-sitter CLI, which nvim-treesitter's main branch compiles parsers
# with. It is here rather than left to mason because LazyVim asks for it the
# moment its treesitter config runs, and during the plugin sync below that
# happens while mason is installing it already: mason refuses the second
# install, and the sync logs an error for a run that is fine. LazyVim asks
# mason only when no tree-sitter is on PATH, so with this one there nothing
# asks twice. The version matches the host's.
ENV TREE_SITTER_VERSION=0.26.11

RUN curl -fsSL -o /tmp/tree-sitter.gz \
      "https://github.com/tree-sitter/tree-sitter/releases/download/v${TREE_SITTER_VERSION}/tree-sitter-linux-x64.gz" \
 && gunzip /tmp/tree-sitter.gz \
 && install -m 0755 /tmp/tree-sitter /usr/local/bin/tree-sitter \
 && rm -f /tmp/tree-sitter \
 && tree-sitter --version

# The config and everything it needs to run: plugins, mason's tools, and the
# treesitter parsers, all compiled here so that the first nvim in a fresh cell
# opens an editor rather than an installer. The bootstrap fails the build if
# any of it is missing, since a cell that has to fetch half an editor on first
# open is the thing this avoids.
#
# One nvim for the sync and the bootstrap, not one each. LazyVim starts mason's
# installs and treesitter's parsers as soon as it loads, so a sync that quit
# with +qa killed them mid-flight — mason logged the aborted installs as an
# error, and the bootstrap's nvim downloaded them all again. In one session the
# bootstrap waits for those installs instead, and its own exit is the only one.
COPY --chmod=0644 nvim-bootstrap.lua /opt/nvim/bootstrap.lua

RUN mkdir -p /opt/nvim/config /opt/nvim/data \
 && git clone --depth 1 https://github.com/dm-balakin/nvim-config /opt/nvim/config/nvim \
 && timeout 1800 nvim --headless "+Lazy! sync" -c "luafile /opt/nvim/bootstrap.lua"

# Go. The work this cell is for is a Go CLI, so the toolchain and the two tools
# its Makefile and its workflows name are in the image rather than fetched into
# a worktree: golangci-lint, which is both the linter and — through
# `golangci-lint fmt` — the formatter, and goreleaser, which the release
# configuration is checked with.
#
# Each is pinned to what solitary's own CI runs, so a lint or a build that
# passes here passes there: Go to the version go.mod asks for (a module that
# asks for more downloads its own toolchain through the proxy), golangci-lint to
# the version verify.yml names — the formatter is the same binary, so `fmt`
# agrees too — and goreleaser to the v2 release the release workflow picks up.
# When one of those moves, this moves with it.
ENV GO_VERSION=1.26.10
ENV GOLANGCI_LINT_VERSION=2.15.0
ENV GORELEASER_VERSION=2.19.0

RUN curl -fsSL -o /tmp/go.tar.gz \
      "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
 && tar -C /usr/local -xzf /tmp/go.tar.gz \
 && rm -f /tmp/go.tar.gz \
 && curl -fsSL -o /tmp/golangci-lint.tar.gz \
      "https://github.com/golangci/golangci-lint/releases/download/v${GOLANGCI_LINT_VERSION}/golangci-lint-${GOLANGCI_LINT_VERSION}-linux-amd64.tar.gz" \
 && tar -C /tmp -xzf /tmp/golangci-lint.tar.gz \
 && install -m 0755 "/tmp/golangci-lint-${GOLANGCI_LINT_VERSION}-linux-amd64/golangci-lint" /usr/local/bin/golangci-lint \
 && curl -fsSL -o /tmp/goreleaser.tar.gz \
      "https://github.com/goreleaser/goreleaser/releases/download/v${GORELEASER_VERSION}/goreleaser_Linux_x86_64.tar.gz" \
 && tar -C /tmp -xzf /tmp/goreleaser.tar.gz goreleaser \
 && install -m 0755 /tmp/goreleaser /usr/local/bin/goreleaser \
 && rm -rf /tmp/golangci-lint.tar.gz /tmp/golangci-lint-${GOLANGCI_LINT_VERSION}-linux-amd64 \
      /tmp/goreleaser.tar.gz /tmp/goreleaser

# GOPATH in the home rather than the image: the module cache and whatever `go
# install` adds are then on the machine's disk, so a rebuilt container does not
# download the world again.
ENV GOPATH=/home/cell/go
ENV PATH=/usr/local/go/bin:/home/cell/go/bin:$PATH

# The website half of the repository is pnpm, and its version is pinned in
# package.json for corepack to read. Enabling corepack here means a worktree
# gets that version rather than whatever is installed; the prompt it would show
# before downloading one has no one to answer it in an agent's shell.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0
RUN corepack enable --install-directory /usr/local/node/bin

# Playwright and the browser it drives, so an agent can open what it is building
# instead of guessing. The browsers live in the image rather than in the default
# ~/.cache: the home is a mount from the machine, so a download made during the
# build would be hidden at run time and every fresh cell would fetch its own.
# Chromium alone — the other two engines are a rebuild away if anything needs
# them. Not pinned, like the agents: each build takes Playwright's latest
# release and the Chromium build that release names.
#
# --with-deps is the apt half: a headless Chromium still wants the X, nss and
# font libraries, and Ubuntu's image has none of them.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
#
# One mirror rather than Playwright's three. The first two lead to
# playwright.download.prss.microsoft.com, which network.allow does not name, so
# every download logged two ENOTFOUND errors before the third, cdn.playwright.dev,
# served it. Set for the cell as well as the build: a project's own
# `playwright install` would walk the same list.
ENV PLAYWRIGHT_DOWNLOAD_HOST=https://cdn.playwright.dev

RUN npm install -g playwright \
 && npm cache clean --force \
 && playwright install --with-deps chromium \
 && rm -rf /var/lib/apt/lists/* \
 # Readable by whoever the cell turns out to run as.
 && chmod -R a+rX /opt/ms-playwright

# qemu and lima, so what is developed here can also be run here. solitary
# drives a lima machine with podman inside it; cell.yaml passes in the node the
# first of those needs — /dev/kvm — and this is the rest of it: an emulator to
# open that node with, UEFI firmware for a guest to boot from, and the ssh
# client lima talks to a machine over once it is up.
#
# A guest booted in here is the third level down: host, cell, guest. Its memory
# and its disk come out of the cell's, which is why this cell asks for more of
# both than its sibling.
#
# lima matches the host's version, like tmux and nvim: what is developed here
# is the thing that drives it.
ENV LIMA_VERSION=2.2.1

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      qemu-system-x86 qemu-utils ovmf openssh-client \
 && rm -rf /var/lib/apt/lists/* \
 && curl -fsSL -o /tmp/lima.tar.gz \
      "https://github.com/lima-vm/lima/releases/download/v${LIMA_VERSION}/lima-${LIMA_VERSION}-Linux-x86_64.tar.gz" \
 && tar -C /usr/local -xzf /tmp/lima.tar.gz \
 && rm -f /tmp/lima.tar.gz

# The user work happens as. limactl refuses to run as root, and a cell is root
# inside its container unless cell.yaml names someone else — so this image has
# a user and cell.yaml names it. Everything runs as `cell`: the agents, tmux,
# and the machines lima starts.
#
# The home this creates is hidden at run time by the mount from the machine,
# which solitary maps onto this user. What does have to change is nvim's data
# directory: the wrapper points XDG_DATA_HOME at the image, and lazy and mason
# write there.
RUN useradd --create-home --home-dir /home/cell --shell /bin/bash cell \
 && chown -R cell:cell /opt/nvim

# Statusline. The script and its settings both live outside /home/cell: that
# path is a mount from the machine, so anything the build puts there is hidden
# at run time. /etc/claude-code is Claude Code's managed settings location,
# which it reads regardless of the home directory.
# The statusline prints rate-limit reset times in local time, so the cell has
# to agree with the host about what local means.
ENV TZ=Europe/Belgrade

COPY --chmod=0755 statusline.sh /usr/local/bin/claude-statusline
RUN mkdir -p /etc/claude-code

# Managed settings carry the statusline and the hooks that mark a tmux window
# with what the agent is doing. ~/.claude/settings.json would be the usual place
# for both; it is in the home directory, so it is not available to the image.
COPY --chmod=0644 claude-settings.json /etc/claude-code/managed-settings.json

# What every agent reads as its global context: what this cell is, and that a
# browser is in it. One file, which cell-init links into the home for Claude
# Code and Codex — opencode reads Claude Code's copy. Both places are in the
# home, so neither can be written here.
COPY --chmod=0644 cell-instructions.md /opt/cell-instructions.md

# Applied at every container start, for the things that have to live in the
# cell's home and so cannot be baked into the image.
COPY --chmod=0755 cell-init.sh /usr/local/bin/cell-init

# The cell's home is a mount from the machine, so anything written here during
# the build would be hidden at run time. Keep build-time state out of it.
WORKDIR /home/cell

RUN node --version && npm --version && gh --version && claude --version \
 && codex --version \
 && opencode --version && tmux -V && nvim --version | head -n 1 \
 && playwright --version \
 && test -d /opt/ms-playwright \
 && go version && golangci-lint --version && goreleaser --version | head -n 3 \
 && su cell -c 'limactl --version' && qemu-system-x86_64 --version | head -n 1 \
 && test -d /opt/nvim/data/nvim/lazy/LazyVim \
 && test "$(ls /opt/nvim/data/nvim/site/parser | wc -l)" -ge 20 \
 && tree-sitter --version
